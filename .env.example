# live or synthetic (synthetic symbols start with SIM)
FEED_MODE=live
SYMBOL_COUNT=50
# Empty means discover the highest 24h quote-volume TRADING USDT perpetuals.
# Set e.g. BTCUSDT,ETHUSDT to select explicitly (overrides SYMBOL_COUNT).
SYMBOLS=
BATCH_MS=20
BATCH_SIZE=250
QUEUE_CAPACITY=10000
SYNTHETIC_INTERVAL_MS=100
BINANCE_REST_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com
DDB_USER=admin
DDB_PASSWORD=123456
GRAFANA_PASSWORD=admin
RUST_LOG=info
